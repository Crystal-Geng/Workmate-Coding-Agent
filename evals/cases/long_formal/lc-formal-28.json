  "script": [
    [
      {
        "name": "write_file",
        "input": {
          "path": "module.py",
          "content": "def solve(method, path, params):\n    query = '&'.join(f'{key}={params[key]}' for key in sorted(params))\n    return f'{method}:{path}:{query}'\n"
        }
      },
      {
        "name": "write_file",
        "input": {
          "path": "config.json",
          "content": "{\"sort_query\": true, \"separator\": \":\"}"

{
  "case_id": "e2e-14",
  "name": "按 region 汇总两个 CSV 的 amount，写 summary.json，键为 ",
  "category": "multi_tool",
  "fixtures": [
    {
      "source": "e2e-14"
    }
  ],
  "graders": [
    {
      "kind": "csv",
      "path": "summary.json",
      "operation": "group_sum",
      "column": "amount",
      "sources": [
        "e2e-14/north.csv",
        "e2e-14/south.csv"
      ]
    },
    {
      "kind": "exists",
      "path": "process.py"
    },
    {
      "kind": "pytest",
      "test_id": "pipeline"
    },
    {
      "kind": "exact",
      "path": "execution.txt",
      "expected": "completed\n"
    },
    {
      "kind": "changes",
      "allowed": [
        "process.py",
        "summary.json",
        "execution.txt"
      ],
      "constraint": true
    }
  ],
  "forbidden_changes": [
    "protected.txt"
  ],
  "required_events": [],
  "timeout_seconds": 120,
  "max_steps": 20,
  "tags": [],
  "script": [
    [
      {
        "name": "read_file",
        "input": {
          "path": "north.csv"
        }
      }
    ],
    [
      {
        "name": "write_file",
        "input": {
          "path": "process.py",
          "content": "import csv,json; from pathlib import Path; rows=[r for p in ['north.csv','south.csv'] for r in csv.DictReader(open(p))]; answer={g:sum(float(r['amount']) for r in rows if r['region']==g) for g in {r['region'] for r in rows}}; Path('summary.json').write_text(json.dumps(answer)); print('completed')\n"
        }
      }
    ],
    [
      {
        "name": "bash",
        "input": {
          "command": "python process.py > execution.txt"
        }
      }
    ]
  ],
  "goal": "按 region 汇总两个 CSV 的 amount，写 summary.json，键为 region，值为合计。先读取数据，再创建 process.py 执行计算。运行脚本，打印 completed 并将标准输出保存到 execution.txt。保留输入。"
}
